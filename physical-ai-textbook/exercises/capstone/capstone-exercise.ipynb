    "## Step 4: Advanced Human-Robot Interaction\n",
    "\n",
    "Implement sophisticated HRI capabilities for safe and effective interaction."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class AdvancedHumanRobotInteraction:\n",
    "    def __init__(self):\n",
    "        # Publisher for HRI status\n",
    "        self.hri_status_pub = rospy.Publisher('/hri_status', String, queue_size=10)\n",
    "        \n",
    "        # Parameters\n",
    "        self.personal_space_radius = 1.0  # meters\n",
    "        self.social_space_radius = 2.0   # meters\n",
    "        self.safety_space_radius = 0.5   # meters\n",
    "        \n",
    "        # HRI state\n",
    "        self.interaction_mode = \"autonomous\"  # autonomous, interactive, manual_control\n",
    "        self.active_interactions = []\n",
    "        \n",
    "        print(\"Advanced Human-Robot Interaction System initialized\")\n",
    "    \n",
    "    def check_human_safety(self, environment_map: Dict) -> Dict:\n",
    "        \"\"\"Check safety regarding humans in environment\"\"\"\n",
    "        safety_status = {\n",
    "            \"humans_detected\": len(environment_map.get(\"humans\", [])) > 0,\n",
    "            \"safety_violations\": [],\n",
    "            \"recommended_action\": \"continue_normal\",\n",
    "            \"interaction_mode\": self.interaction_mode\n",
    "        }\n",
    "        \n",
    "        robot_pos = environment_map.get(\"robot_pose\", {})\n",
    "        if robot_pos:\n",
    "            robot_x = robot_pos.get(\"x\", 0.0)\n",
    "            robot_y = robot_pos.get(\"y\", 0.0)\n",
    "        else:\n",
    "            robot_x, robot_y = 0.0, 0.0\n",
    "        \n",
    "        for human in environment_map.get(\"humans\", []):\n",
    "            human_x = human.get(\"x\", 0.0)\n",
    "            human_y = human.get(\"y\", 0.0)\n",
    "            \n",
    "            dist_to_human = np.sqrt((robot_x - human_x)**2 + (robot_y - human_y)**2)\n",
    "            \n",
    "            if dist_to_human < self.safety_space_radius:\n",
    "                safety_status[\"safety_violations\"].append({\n",
    "                    \"type\": \"too_close\",\n",
    "                    \"distance\": dist_to_human,\n",
    "                    \"recommended_action\": \"emergency_stop\"\n",
    "                })\n",
    "                safety_status[\"recommended_action\"] = \"emergency_stop\"\n",
    "            elif dist_to_human < self.personal_space_radius:\n",
    "                safety_status[\"safety_violations\"].append({\n",
    "                    \"type\": \"in_personal_space\",\n",
    "                    \"distance\": dist_to_human,\n",
    "                    \"recommended_action\": \"reduce_speed\"\n",
    "                })\n",
    "                if safety_status[\"recommended_action\"] == \"continue_normal\":\n",
    "                    safety_status[\"recommended_action\"] = \"reduce_speed\"\n",
    "            elif dist_to_human < self.social_space_radius:\n",
    "                safety_status[\"safety_violations\"].append({\n",
    "                    \"type\": \"in_social_space\",\n",
    "                    \"distance\": dist_to_human,\n",
    "                    \"recommended_action\": \"acknowledge_presence\"\n",
    "                })\n",
    "        \n",
    "        return safety_status\n",
    "    \n",
    "    def generate_hri_response(self, human_action: str, context: Dict = None) -> str:\n",
    "        \"\"\"Generate appropriate response to human action\"\"\"\n",
    "        responses = {\n",
    "            \"wave\": \"Hello! I see you. How can I assist you today?\",\n",
    "            \"point\": \"I see you're pointing. Let me navigate to that location safely.\",\n",
    "            \"stop\": \"Stopping immediately. How else may I help?\",\n",
    "            \"follow\": \"I can follow you. Please maintain a safe distance and be aware of obstacles.\"\n",
    "        }\n",
    "        \n",
    "        response = responses.get(human_action, \"I acknowledge your presence. I'm continuing my current task safely.\")\n",
    "        \n",
    "        # Add context-specific information\n",
    "        if context:\n",
    "            if context.get('task_in_progress'):\n",
    "                response += f\" I'm currently {context['task_in_progress']}.\"\n",
    "            if context.get('estimated_completion'):\n",
    "                response += f\" Estimated completion: {context['estimated_completion']} seconds.\"\n",
    "        \n",
    "        return response\n",
    "    \n",
    "    def manage_interaction(self, environment_map: Dict) -> Dict:\n",
    "        \"\"\"Manage ongoing human-robot interactions\"\"\"\n",
    "        hri_status = self.check_human_safety(environment_map)\n",
    "        \n",
    "        # Update interaction mode based on safety status\n",
    "        if hri_status[\"recommended_action\"] == \"emergency_stop\":\n",
    "            self.interaction_mode = \"manual_control\"\n",
    "        elif hri_status[\"safety_violations\"]:\n",
    "            self.interaction_mode = \"interactive\"\n",
    "        else:\n",
    "            self.interaction_mode = \"autonomous\"\n",
    "        \n",
    "        hri_status[\"interaction_mode\"] = self.interaction_mode\n",
    "        \n",
    "        # Publish HRI status\n",
    "        self.hri_status_pub.publish(String(json.dumps(hri_status)))\n",
    "        \n",
    "        return hri_status\n",
    "\n",
    "# Initialize HRI system\n",
    "hri_system = AdvancedHumanRobotInteraction()\n",
    "print(\"Advanced Human-Robot Interaction System initialized\")"
   ]
