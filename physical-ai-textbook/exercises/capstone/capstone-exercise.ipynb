    "## Step 3: Adaptive Control System\n",
    "\n",
    "Implement a control system that adapts its behavior based on environmental conditions and safety requirements."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class AdaptiveControlSystem:\n",
    "    def __init__(self):\n",
    "        # Publisher for velocity commands\n",
    "        self.cmd_vel_pub = rospy.Publisher('/cmd_vel', Twist, queue_size=10)\n",
    "        \n",
    "        # Parameters for adaptive control\n",
    "        self.max_linear_vel = 0.5  # m/s\n",
    "        self.max_angular_vel = 0.5  # rad/s\n",
    "        self.safety_enabled = True\n",
    "        \n",
    "        # Adaptive parameters\n",
    "        self.adaptive_params = {\n",
    "            'normal_speed_factor': 1.0,\n",
    "            'safety_speed_factor': 0.3,\n",
    "            'crowded_area_factor': 0.5,\n",
    "            'emergency_stop_distance': 0.5  # meters\n",
    "        }\n",
    "        \n",
    "        # Robot state\n",
    "        self.is_moving = False\n",
    "        self.emergency_stop_active = False\n",
    "        \n",
    "        print(\"Adaptive Control System initialized\")\n",
    "    \n",
    "    def move_robot(self, linear_x: float = 0.0, linear_y: float = 0.0, linear_z: float = 0.0,\n",
    "                   angular_x: float = 0.0, angular_y: float = 0.0, angular_z: float = 0.0,\n",
    "                   environment_map: Dict = None):\n",
    "        \"\"\"Send velocity commands to robot with adaptive parameters\"\"\"\n",
    "        if self.emergency_stop_active:\n",
    "            self.stop_robot()\n",
    "            return\n",
    "        \n",
    "        cmd = Twist()\n",
    "        \n",
    "        # Apply adaptive speed factors based on environment\n",
    "        speed_factor = self._calculate_speed_factor(environment_map)\n",
    "        \n",
    "        cmd.linear.x = max(min(linear_x * speed_factor, self.max_linear_vel), -self.max_linear_vel)\n",
    "        cmd.linear.y = max(min(linear_y * speed_factor, self.max_linear_vel), -self.max_linear_vel)\n",
    "        cmd.linear.z = max(min(linear_z * speed_factor, self.max_linear_vel), -self.max_linear_vel)\n",
    "        cmd.angular.x = max(min(angular_x * speed_factor, self.max_angular_vel), -self.max_angular_vel)\n",
    "        cmd.angular.y = max(min(angular_y * speed_factor, self.max_angular_vel), -self.max_angular_vel)\n",
    "        cmd.angular.z = max(min(angular_z * speed_factor, self.max_angular_vel), -self.max_angular_vel)\n",
    "        \n",
    "        # Apply safety constraints\n",
    "        if self.safety_enabled:\n",
    "            cmd = self._apply_safety_constraints(cmd, environment_map)\n",
    "        \n",
    "        self.cmd_vel_pub.publish(cmd)\n",
    "        self.is_moving = True\n",
    "    \n",
    "    def _calculate_speed_factor(self, environment_map: Dict) -> float:\n",
    "        \"\"\"Calculate speed factor based on environment\"\"\"\n",
    "        if environment_map is None:\n",
    "            return self.adaptive_params['normal_speed_factor']\n",
    "        \n",
    "        # Check for humans nearby\n",
    "        humans = environment_map.get('humans', [])\n",
    "        if humans:\n",
    "            # Find closest human\n",
    "            closest_human_dist = min([h.get('distance', float('inf')) for h in humans])\n",
    "            \n",
    "            if closest_human_dist < self.adaptive_params['emergency_stop_distance']:\n",
    "                # Emergency stop\n",
    "                self.enable_emergency_stop()\n",
    "                return 0.0\n",
    "            elif closest_human_dist < 1.0:  # Personal space\n",
    "                return self.adaptive_params['safety_speed_factor']\n",
    "            elif closest_human_dist < 2.0:  # Social space\n",
    "                return self.adaptive_params['crowded_area_factor']\n",
    "        \n",
    "        # Check for obstacles\n",
    "        obstacles = environment_map.get('obstacles', [])\n",
    "        if obstacles:\n",
    "            closest_obstacle_dist = min([o.get('distance', float('inf')) for o in obstacles])\n",
    "            if closest_obstacle_dist < 0.7:  # Near obstacle\n",
    "                return self.adaptive_params['safety_speed_factor']\n",
    "        \n",
    "        return self.adaptive_params['normal_speed_factor']\n",
    "    \n",
    "    def _apply_safety_constraints(self, cmd: Twist, environment_map: Dict) -> Twist:\n",
    "        \"\"\"Apply safety constraints to velocity commands\"\"\"\n",
    "        if environment_map is None:\n",
    "            return cmd\n",
    "        \n",
    "        # Reduce speed if humans are very close\n",
    "        humans = environment_map.get('humans', [])\n",
    "        for human in humans:\n",
    "            if human.get('distance', float('inf')) < 0.5:\n",
    "                # Emergency stop if too close\n",
    "                cmd.linear.x = 0.0\n",
    "                cmd.angular.z = 0.0\n",
    "                self.enable_emergency_stop()\n",
    "                return cmd\n",
    "        \n",
    "        return cmd\n",
    "    \n",
    "    def stop_robot(self):\n",
    "        \"\"\"Stop the robot immediately\"\"\"\n",
    "        cmd = Twist()\n",
    "        self.cmd_vel_pub.publish(cmd)\n",
    "        self.is_moving = False\n",
    "    \n",
    "    def execute_navigation(self, goal_pose: Pose, environment_map: Dict):\n",
    "        \"\"\"Execute navigation to goal pose with adaptive behavior\"\"\"\n",
    "        # This would typically interface with a path planner\n",
    "        # For this exercise, we'll simulate navigation\n",
    "        print(f\"Navigating to goal with adaptive behavior based on environment\")\n",
    "        return True\n",
    "    \n",
    "    def enable_emergency_stop(self):\n",
    "        \"\"\"Enable emergency stop\"\"\"\n",
    "        self.emergency_stop_active = True\n",
    "        self.stop_robot()\n",
    "    \n",
    "    def disable_emergency_stop(self):\n",
    "        \"\"\"Disable emergency stop\"\"\"\n",
    "        self.emergency_stop_active = False\n",
