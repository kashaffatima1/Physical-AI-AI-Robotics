    "## Step 2: Advanced Decision Making System\n",
    "\n",
    "Implement a sophisticated decision-making system that can prioritize tasks, handle emergencies, and adapt to changing conditions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class TaskState(Enum):\n",
    "    IDLE = \"idle\"\n",
    "    PLANNING = \"planning\"\n",
    "    EXECUTING = \"executing\"\n",
    "    COMPLETED = \"completed\"\n",
    "    FAILED = \"failed\"\n",
    "    EMERGENCY_STOP = \"emergency_stop\"\n",
    "\n",
    "@dataclass\n",
    "class TaskDefinition:\n",
    "    id: str\n",
    "    name: str\n",
    "    description: str\n",
    "    priority: int  # 1-10 scale, 10 is highest\n",
    "    required_resources: List[str]\n",
    "    estimated_duration: float  # in seconds\n",
    "    success_criteria: List[str]\n",
    "    dependencies: List[str] = None\n",
    "\n",
    "    def __post_init__(self):\n",
    "        if self.dependencies is None:\n",
    "            self.dependencies = []\n",
    "\n",
    "class AdvancedDecisionMakingSystem:\n",
    "    def __init__(self):\n",
    "        self.current_task = None\n",
    "        self.task_queue = []\n",
    "        self.task_history = []\n",
    "        self.emergency_active = False\n",
    "        self.task_prioritizer = TaskPrioritizer()\n",
    "        \n",
    "        # Publishers for task management\n",
    "        self.task_status_pub = rospy.Publisher('/task_status', String, queue_size=10)\n",
    "        \n",
    "        print(\"Advanced Decision Making System initialized\")\n",
    "    \n",
    "    def add_task(self, task: TaskDefinition):\n",
    "        \"\"\"Add a task to the queue\"\"\"\n",
    "        self.task_queue.append(task)\n",
    "        # Re-sort by priority\n",
    "        self.task_queue.sort(key=lambda t: t.priority, reverse=True)\n",
    "    \n",
    "    def get_next_task(self, environment_map: Dict) -> Optional[TaskDefinition]:\n",
    "        \"\"\"Get the next task to execute based on priority and environment\"\"\"\n",
    "        if not self.task_queue:\n",
    "            return None\n",
    "        \n",
    "        # Use task prioritizer to select next task based on environment\n",
    "        prioritized_tasks = self.task_prioritizer.prioritize_tasks(\n",
    "            self.task_queue, environment_map\n",
    "        )\n",
    "        \n",
    "        for task in prioritized_tasks:\n",
    "            if self._dependencies_satisfied(task):\n",
    "                return task\n",
    "        \n",
    "        return None\n",
    "    \n",
    "    def _dependencies_satisfied(self, task: TaskDefinition) -> bool:\n",
    "        \"\"\"Check if task dependencies are satisfied\"\"\"\n",
    "        for dep_id in task.dependencies:\n",
    "            dep_completed = any(t.id == dep_id and t.id in [h.id for h in self.task_history]\n",
    "                              for t in self.task_history)\n",
    "            if not dep_completed:\n",
    "                return False\n",
    "        return True\n",
    "    \n",
    "    def make_decision(self, environment_map: Dict) -> Optional[TaskDefinition]:\n",
    "        \"\"\"Make a decision based on current environment\"\"\"\n",
    "        # Check for emergencies first\n",
    "        if self._check_emergency(environment_map):\n",
    "            self.emergency_active = True\n",
    "            return self._create_emergency_task()\n",
    "        \n",
    "        # Get next task based on environment\n",
    "        next_task = self.get_next_task(environment_map)\n",
    "        \n",
    "        # Update current task if none is active\n",
    "        if self.current_task is None and next_task:\n",
    "            self.current_task = next_task\n",
    "            self._publish_task_status(self.current_task, TaskState.PLANNING)\n",
    "        \n",
    "        return next_task\n",
    "    \n",
    "    def _check_emergency(self, environment_map: Dict) -> bool:\n",
    "        \"\"\"Check if there's an emergency situation\"\"\"\n",
    "        # Emergency if humans are very close (less than 0.5m)\n",
    "        for human in environment_map.get(\"humans\", []):\n",
    "            if human.get(\"distance\", float('inf')) < 0.5:\n",
    "                return True\n",
    "        return False\n",
    "    \n",
    "    def _create_emergency_task(self) -> TaskDefinition:\n",
    "        \"\"\"Create an emergency task\"\"\"\n",
    "        return TaskDefinition(\n",
    "            id=\"emergency_stop_\" + str(int(time.time())),\n",
    "            name=\"Emergency Stop\",\n",
    "            description=\"Immediate stop due to safety concern\",\n",
    "            priority=10,\n",
    "            required_resources=[\"navigation\", \"control\"],\n",
    "            estimated_duration=1.0,\n",
    "            success_criteria=[\"robot_stopped\", \"safety_ensured\"]\n",
    "        )\n",
    "    \n",
    "    def update_task_status(self, task_id: str, status: TaskState):\n",
    "        \"\"\"Update the status of a task\"\"\"\n",
    "        if self.current_task and self.current_task.id == task_id:\n",
    "            self._publish_task_status(self.current_task, status)\n",
    "            \n",
    "            if status in [TaskState.COMPLETED, TaskState.FAILED]:\n",
    "                # Move current task to history\n",
    "                self.task_history.append(self.current_task)\n",
    "                self.current_task = None\n",
    "                # Remove from queue\n",
    "                self.task_queue = [t for t in self.task_queue if t.id != task_id]\n",
    "    \n",
    "    def _publish_task_status(self, task: TaskDefinition, status: TaskState):\n",
    "        \"\"\"Publish task status to ROS topic\"\"\"\n",
    "        status_msg = {\n",
    "            \"task_id\": task.id,\n",
    "            \"task_name\": task.name,\n",
    "            \"status\": status.value,\n",
    "            \"timestamp\": rospy.Time.now().to_sec()\n",
    "        }\n",
    "        self.task_status_pub.publish(String(json.dumps(status_msg)))\n",
    "\n",
    "class TaskPrioritizer:\n",
    "    \"\"\"Class to prioritize tasks based on environment and context\"\"\"\n",
    "    \n",
    "    def prioritize_tasks(self, tasks: List[TaskDefinition], environment_map: Dict) -> List[TaskDefinition]:\n",
    "        \"\"\"Prioritize tasks based on environment and context\"\"\"\n",
    "        # For this exercise, we'll adjust priorities based on environment\n",
    "        adjusted_tasks = []\n",
    "        \n",
    "        for task in tasks:\n",
    "            adjusted_task = TaskDefinition(\n",
    "                id=task.id,\n",
    "                name=task.name,\n",
    "                description=task.description,\n",
    "                priority=self._adjust_priority_for_environment(task, environment_map),\n",
    "                required_resources=task.required_resources,\n",
    "                estimated_duration=task.estimated_duration,\n",
    "                success_criteria=task.success_criteria,\n",
    "                dependencies=task.dependencies\n",
    "            )\n",
    "            adjusted_tasks.append(adjusted_task)\n",
    "        \n",
    "        # Sort by adjusted priority\n",
    "        adjusted_tasks.sort(key=lambda t: t.priority, reverse=True)\n",
    "        return adjusted_tasks\n",
    "    \n",
    "    def _adjust_priority_for_environment(self, task: TaskDefinition, environment_map: Dict) -> int:\n",
    "        \"\"\"Adjust task priority based on environment\"\"\"\n",
    "        # Increase priority for safety-related tasks if humans are nearby\n",
    "        if \"safety\" in task.name.lower() and environment_map.get(\"safety_zone_active\", False):\n",
    "            return min(10, task.priority + 2)  # Boost priority up to 10\n",
    "        \n",
    "        # Decrease priority if environment is risky\n",
    "        if environment_map.get(\"safety_zone_active\", False) and \"navigation\" in task.required_resources:\n",
    "            return max(1, task.priority - 1)  # Reduce priority by 1\n",
    "        \n",
    "        return task.priority\n",
    "\n",
    "# Initialize decision making system\n",
    "decision_system = AdvancedDecisionMakingSystem()\n",
    "print(\"Advanced Decision Making System initialized\")"
   ]
  },
