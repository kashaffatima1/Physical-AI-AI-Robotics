    "## Step 5: Performance Evaluation System\n",
    "\n",
    "Implement a system to evaluate the performance of the Physical AI system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class PerformanceEvaluationSystem:\n",
    "    def __init__(self):\n",
    "        self.metrics = {\n",
    "            'task_completion_rate': 0.0,\n",
    "            'safety_violations': 0,\n",
    "            'navigation_efficiency': 0.0,\n",
    "            'human_interaction_quality': 0.0,\n",
    "            'system_uptime': 0.0,\n",
    "            'computation_efficiency': 0.0\n",
    "        }\n",
    "        \n",
    "        self.evaluation_history = []\n",
    "        self.start_time = rospy.Time.now().to_sec()\n",
    "        \n",
    "        print(\"Performance Evaluation System initialized\")\n",
    "    \n",
    "    def evaluate_task_performance(self, task: TaskDefinition, environment_map: Dict, \n",
    "                                  execution_time: float, success: bool) -> Dict:\n",
    "        \"\"\"Evaluate performance of a completed task\"\"\"\n",
    "        # Calculate task-specific metrics\n",
    "        efficiency_score = self._calculate_efficiency(task, execution_time)\n",
    "        safety_score = self._calculate_safety_score(environment_map)\n",
    "        \n",
    "        task_evaluation = {\n",
    "            'task_id': task.id,\n",
    "            'task_name': task.name,\n",
    "            'success': success,\n",
    "            'execution_time': execution_time,\n",
    "            'efficiency_score': efficiency_score,\n",
    "            'safety_score': safety_score,\n",
    "            'timestamp': rospy.Time.now().to_sec()\n",
    "        }\n",
    "        \n",
    "        # Update global metrics\n",
    "        if success:\n",
    "            self.metrics['task_completion_rate'] = \\\n",
    "                (self.metrics['task_completion_rate'] * len(self.evaluation_history) + 1.0) / \\\n",
    "                (len(self.evaluation_history) + 1)\n",
    "        else:\n",
    "            self.metrics['task_completion_rate'] = \\\n",
    "                (self.metrics['task_completion_rate'] * len(self.evaluation_history)) / \\\n",
    "                (len(self.evaluation_history) + 1)\n",
    "        \n",
    "        # Add to history\n",
    "        self.evaluation_history.append(task_evaluation)\n",
    "        \n",
    "        return task_evaluation\n",
    "    \n",
    "    def _calculate_efficiency(self, task: TaskDefinition, execution_time: float) -> float:\n",
    "        \"\"\"Calculate efficiency score based on estimated vs actual time\"\"\"\n",
    "        if task.estimated_duration > 0:\n",
    "            time_efficiency = task.estimated_duration / execution_time\n",
    "            # Normalize to 0-1 scale, with 1.0 being perfect efficiency\n",
    "            return min(1.0, time_efficiency)\n",
    "        return 0.5  # Default score if no estimate\n",
    "    \n",
    "    def _calculate_safety_score(self, environment_map: Dict) -> float:\n",
    "        \"\"\"Calculate safety score based on environment\"\"\"\n",
    "        # Check for safety violations\n",
    "        humans = environment_map.get('humans', [])\n",
    "        close_humans = [h for h in humans if h.get('distance', float('inf')) < 0.5]\n",
    "        \n",
    "        if close_humans:\n",
    "            self.metrics['safety_violations'] += len(close_humans)\n",
    "            return 0.0  # Safety violation\n",
    "        \n",
    "        # Higher score for maintaining good distance\n",
    "        if humans:\n",
    "            avg_distance = sum(h.get('distance', 0) for h in humans) / len(humans)\n",
    "            return min(1.0, avg_distance / 3.0)  # Score based on distance\n",
    "        \n",
    "        return 1.0  # Perfect safety if no humans\n",
    "    \n",
    "    def get_overall_performance(self) -> Dict:\n",
    "        \"\"\"Get overall performance metrics\"\"\"\n",
    "        # Calculate system uptime\n",
    "        current_time = rospy.Time.now().to_sec()\n",
    "        total_time = current_time - self.start_time\n",
    "        \n",
    "        if total_time > 0:\n",
    "            self.metrics['system_uptime'] = \\\n",
    "                (total_time - self._get_downtime()) / total_time\n",
    "        \n",
    "        return {\n",
    "            'current_metrics': self.metrics,\n",
    "            'total_tasks_completed': len(self.evaluation_history),\n",
    "            'evaluation_period': total_time,\n",
    "            'performance_summary': self._generate_performance_summary()\n",
    "        }\n",
    "    \n",
    "    def _get_downtime(self) -> float:\n",
    "        \"\"\"Calculate system downtime (simplified)\"\"\"\n",
    "        # In a real system, this would track actual downtime\n",
    "        return 0.0\n",
    "    \n",
    "    def _generate_performance_summary(self) -> str:\n",
    "        \"\"\"Generate a text summary of performance\"\"\"\n",
    "        summary = f\"Performance Summary:\\n\"\n",
    "        summary += f\"- Task Completion Rate: {self.metrics['task_completion_rate']:.2f}\\n\"\n",
    "        summary += f\"- Safety Violations: {self.metrics['safety_violations']}\\n\"\n",
    "        summary += f\"- Total Tasks Evaluated: {len(self.evaluation_history)}\\n\"\n",
    "        \n",
    "        if self.metrics['task_completion_rate'] >= 0.8:\n",
    "            summary += \"- Performance: Excellent\\n\"\n",
    "        elif self.metrics['task_completion_rate'] >= 0.6:\n",
    "            summary += \"- Performance: Good\\n\"\n",
    "        elif self.metrics['task_completion_rate'] >= 0.4:\n",
    "            summary += \"- Performance: Fair\\n\"\n",
    "        else:\n",
    "            summary += \"- Performance: Needs Improvement\\n\"\n",
    "        \n",
    "        return summary\n",
    "\n",
    "# Initialize evaluation system\n",
    "evaluation_system = PerformanceEvaluationSystem()\n",
    "print(\"Performance Evaluation System initialized\")"
   ]
