   "source": [
    "## Exercise 3: Simulating the Navigation Environment\n",
    "\n",
    "Let's create a simulation environment to test our navigation system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Create a simulation environment\n",
    "class NavigationSimulation:\n",
    "    def __init__(self, width=10, height=10):\n",
    "        self.width = width\n",
    "        self.height = height\n",
    "        self.robot_pos = np.array([1.0, 1.0])\n",
    "        self.robot_orient = 0.0\n",
    "        self.robot_vel = np.array([0.0, 0.0])\n",
    "        self.goal = np.array([8.0, 8.0])\n",
    "        \n",
    "        # Add some obstacles\n",
    "        self.obstacles = [\n",
    "            {'center': np.array([4.0, 3.0]), 'radius': 0.5},\n",
    "            {'center': np.array([6.0, 5.0]), 'radius': 0.7},\n",
    "            {'center': np.array([3.0, 7.0]), 'radius': 0.4}\n",
    "        ]\n",
    "        \n",
    "        # Initialize navigation system\n",
    "        self.nav_system = NavigationSystem()\n",
    "        self.nav_system.goal = self.goal\n",
    "        \n",
    "    def detect_obstacles_around_robot(self):\n",
    "        \"\"\"Detect obstacles in the vicinity of the robot\"\"\"\n",
    "        detected = []\n",
    "        detection_range = 2.0\n",
    "        \n",
    "        for obs in self.obstacles:\n",
    "            dist = np.linalg.norm(self.robot_pos - obs['center'])\n",
    "            if dist < detection_range + obs['radius']:\n",
    "                detected.append({\n",
    "                    'x': obs['center'][0],\n",
    "                    'y': obs['center'][1],\n",
    "                    'radius': obs['radius']\n",
    "                })\n",
    "        \n",
    "        return detected\n",
    "    \n",
    "    def simulate_step(self, dt=0.05):\n",
    "        \"\"\"Simulate one step of navigation\"\"\"\n",
    "        # Update navigation system with current state\n",
    "        self.nav_system.update_robot_state(self.robot_pos, self.robot_orient, self.robot_vel)\n",
    "        \n",
    "        # Detect obstacles\n",
    "        obstacles = self.detect_obstacles_around_robot()\n",
    "        self.nav_system.detected_obstacles = obstacles\n",
    "        \n",
    "        # Compute control commands\n",
    "        linear_vel, angular_vel = self.nav_system.compute_control_commands()\n",
    "        \n",
    "        # Update robot state based on commands\n",
    "        self.robot_orient += angular_vel * dt\n",
    "        \n",
    "        # Update position\n",
    "        dx = linear_vel[0] * math.cos(self.robot_orient) * dt\n",
    "        dy = linear_vel[0] * math.sin(self.robot_orient) * dt\n",
    "        \n",
    "        self.robot_pos[0] += dx\n",
    "        self.robot_pos[1] += dy\n",
    "        \n",
    "        # Update velocity\n",
    "        self.robot_vel[0] = linear_vel[0]\n",
    "        \n",
    "        # Check for collisions with obstacles\n",
    "        for obs in self.obstacles:\n",
    "            dist = np.linalg.norm(self.robot_pos - obs['center'])\n",
    "            if dist < obs['radius']:\n",
    "                print(f\"Collision detected at {self.robot_pos}\")\n",
    "                return True  # Collision occurred\n",
    "        \n",
    "        # Check if goal reached\n",
    "        dist_to_goal = np.linalg.norm(self.robot_pos - self.goal)\n",
    "        if dist_to_goal < 0.5:\n",
    "            print(f\"Goal reached at {self.robot_pos}\")\n",
    "            return False  # Success\n",
    "        \n",
    "        return False  # Continue simulation\n",
    "    \n",
    "    def visualize(self, step_num=0):\n",
    "        \"\"\"Visualize the current state of the simulation\"\"\"\n",
    "        fig, ax = plt.subplots(1, 1, figsize=(10, 10))\n",
    "        \n",
    "        # Plot obstacles\n",
    "        for obs in self.obstacles:\n",
    "            circle = plt.Circle(obs['center'], obs['radius'], color='red', alpha=0.3)\n",
    "            ax.add_patch(circle)\n",
    "        \n",
    "        # Plot robot\n",
    "        robot_circle = plt.Circle(self.robot_pos, 0.2, color='blue', alpha=0.7)\n",
    "        ax.add_patch(robot_circle)\n",
    "        \n",
    "        # Plot robot orientation\n",
    "        orient_x = self.robot_pos[0] + 0.3 * math.cos(self.robot_orient)\n",
    "        orient_y = self.robot_pos[1] + 0.3 * math.sin(self.robot_orient)\n",
    "        ax.arrow(self.robot_pos[0], self.robot_pos[1], \n",
    "                0.3 * math.cos(self.robot_orient), 0.3 * math.sin(self.robot_orient),\n",
    "                head_width=0.1, head_length=0.1, fc='blue', ec='blue')\n",
    "        \n",
    "        # Plot goal\n",
    "        goal_circle = plt.Circle(self.goal, 0.3, color='green', alpha=0.5)\n",
    "        ax.add_patch(goal_circle)\n",
    "        \n",
    "        # Plot detected obstacles\n",
    "        detected = self.detect_obstacles_around_robot()\n",
    "        for obs in detected:\n",
    "            circle = plt.Circle([obs['x'], obs['y']], obs['radius'], color='orange', alpha=0.5, linestyle='--')\n",
    "            ax.add_patch(circle)\n",
    "        \n",
    "        ax.set_xlim(0, self.width)\n",
    "        ax.set_ylim(0, self.height)\n",
    "        ax.set_aspect('equal')\n",
    "        ax.grid(True)\n",
    "        ax.set_title(f'Navigation Simulation - Step {step_num}')\n",
    "        \n",
    "        plt.show()\n",
    "\n",
    "# Create simulation instance\n",
    "sim = NavigationSimulation()\n",
    "print(\"Navigation simulation initialized\")"
   ]
  },
