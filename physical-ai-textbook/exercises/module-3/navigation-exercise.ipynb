    "    \n",
    "    # Check if goal is reached\n",
    "    dist_to_goal = np.linalg.norm(sim.robot_pos - sim.goal)\n",
    "    if dist_to_goal < 0.5:\n",
    "        print(f\"Goal reached successfully at step {step}\")\n",
    "        break\n",
    "    \n",
    "    # Small delay to simulate real-time processing\n",
    "    time.sleep(0.01)\n",
    "\n",
    # Final visualization\n",
    "sim.visualize(step_num=max_steps)\n",
    "\n",
    "if not collision_occurred and dist_to_goal >= 0.5:\n",
    "    print(f\"Simulation completed after {max_steps} steps without reaching goal\")\n",
    "\n",
    "print(f\"Final robot position: {sim.robot_pos}\")\n",
    "print(f\"Final distance to goal: {dist_to_goal:.2f}m\")"
   ]
