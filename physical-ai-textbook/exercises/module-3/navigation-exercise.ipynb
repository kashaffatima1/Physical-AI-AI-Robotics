    "## Exercise 6: Performance Evaluation\n",
    "\n",
    "Let's evaluate the performance of our navigation system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def evaluate_navigation_performance(nav_system, start_pos, goal_pos, obstacles, max_time=60):\n",
    "    \"\"\"Evaluate navigation performance metrics\"\"\"\n",
    "    \n",
    "    # Initialize system\n",
    "    nav_system.position = np.array(start_pos)\n",
    "    nav_system.goal = np.array(goal_pos)\n",
    "    nav_system.detected_obstacles = obstacles\n",
    "    \n",
    "    # Track metrics\n",
    "    path_points = [start_pos]\n",
    "    start_time = time.time()\n",
    "    time_taken = 0\n",
    "    distance_traveled = 0\n",
    "    collision_count = 0\n",
    "    \n",
    "    prev_pos = np.array(start_pos)\n",
    "    \n",
    "    # Simulate navigation\n",
    "    for step in range(int(max_time / 0.1)):  # 10Hz control loop\n",
    "        # Compute control commands\n",
    "        linear_vel, angular_vel = nav_system.compute_potential_field_control()\n",
    "        \n",
    "        # Update position (simplified physics)\n",
    "        dt = 0.1\n",
    "        nav_system.orientation += angular_vel * dt\n",
    "        \n",
    "        dx = linear_vel[0] * math.cos(nav_system.orientation) * dt\n",
    "        dy = linear_vel[0] * math.sin(nav_system.orientation) * dt\n",
    "        \n",
    "        nav_system.position[0] += dx\n",
    "        nav_system.position[1] += dy\n",
    "        \n",
    "        # Add to path\n",
    "        path_points.append(nav_system.position.copy())\n",
    "        \n",
    "        # Update distance traveled\n",
    "        distance_traveled += np.linalg.norm(nav_system.position - prev_pos)\n",
    "        prev_pos = nav_system.position.copy()\n",
    "        \n",
    "        # Check for collisions with obstacles\n",
    "        for obs in obstacles:\n",
    "            dist = np.linalg.norm(nav_system.position - np.array([obs['x'], obs['y']]))\n",
    "            if dist < obs['radius'] + 0.2:  # Robot radius\n",
    "                collision_count += 1\n",
    "                print(f\"Collision at step {step}, position: {nav_system.position}\")\n",
    "                # For simulation, move robot back\n",
    "                nav_system.position = path_points[-2] if len(path_points) > 1 else start_pos\n",
    "        \n",
    "        # Check if goal reached\n",
    "        dist_to_goal = np.linalg.norm(nav_system.position - goal_pos)\n",
    "        if dist_to_goal < 0.5:\n",
    "            time_taken = step * dt\n",
    "            break\n",
    "    \n",
    "    # Calculate metrics\n",
    "    straight_line_distance = np.linalg.norm(np.array(goal_pos) - np.array(start_pos))\n",
    "    path_efficiency = straight_line_distance / distance_traveled if distance_traveled > 0 else 0\n",
    "    \n",
    "    metrics = {\n",
    "        'time_taken': time_taken,\n",
    "        'distance_traveled': distance_traveled,\n",
    "        'straight_line_distance': straight_line_distance,\n",
    "        'path_efficiency': path_efficiency,\n",
    "        'collision_count': collision_count,\n",
    "        'success': dist_to_goal < 0.5,\n",
    "        'final_distance_to_goal': dist_to_goal\n",
    "    }\n",
    "    \n",
    "    return metrics, path_points\n",
    "\n",
    "# Evaluate the potential field navigation\n",
    "obstacles_for_eval = [\n",
    "    {'x': 4.0, 'y': 3.0, 'radius': 0.5},\n",
    "    {'x': 6.0, 'y': 5.0, 'radius': 0.7},\n",
    "    {'x': 3.0, 'y': 7.0, 'radius': 0.4}\n",
    "]\n",
    "\n",
    "metrics, path = evaluate_navigation_performance(\n",
    "    PotentialFieldNavigation(), \n",
    "    [1.0, 1.0], \n",
    "    [8.0, 8.0], \n",
    "    obstacles_for_eval\n",
    ")\n",
    "\n",
    "print(\"Navigation Performance Metrics:\")\n",
    "print(f\"- Time taken: {metrics['time_taken']:.2f}s\")\n",
    "print(f\"- Distance traveled: {metrics['distance_traveled']:.2f}m\")\n",
    "print(f\"- Straight line distance: {metrics['straight_line_distance']:.2f}m\")\n",
    "print(f\"- Path efficiency: {metrics['path_efficiency']:.2f}\")\n",
    "print(f\"- Collisions: {metrics['collision_count']}\")\n",
    "print(f\"- Success: {metrics['success']}\")\n",
    "print(f\"- Final distance to goal: {metrics['final_distance_to_goal']:.2f}m\")\n",
    "\n",
    "# Visualize the path\n",
    "if path:\n",
    "    path_array = np.array(path)\n",
    "    plt.figure(figsize=(10, 10))\n",
    "    \n",
    "    # Plot path\n",
    "    plt.plot(path_array[:, 0], path_array[:, 1], 'b-', linewidth=2, label='Navigation Path')\n",
    "    plt.plot(path_array[0, 0], path_array[0, 1], 'go', markersize=10, label='Start')\n",
    "    plt.plot(path_array[-1, 0], path_array[-1, 1], 'ro', markersize=10, label='End')\n",
    "    plt.plot(8.0, 8.0, 'g*', markersize=15, label='Goal')\n",
    "    \n",
    "    # Plot obstacles\n",
    "    for obs in obstacles_for_eval:\n",
    "        circle = plt.Circle((obs['x'], obs['y']), obs['radius'], color='red', alpha=0.3)\n",
    "        plt.add_patch(circle)\n",
    "    \n",
    "    plt.grid(True)\n",
    "    plt.axis('equal')\n",
    "    plt.legend()\n",
    "    plt.title('Navigation Path Visualization')\n",
    "    plt.xlabel('X (m)')\n",
    "    plt.ylabel('Y (m)')\n",
    "    plt.show()"
   ]
