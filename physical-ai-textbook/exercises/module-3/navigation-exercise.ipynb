    "## Exercise 5: Implementing a More Sophisticated Navigation Algorithm\n",
    "\n",
    "Let's implement a more advanced navigation algorithm that uses potential fields for obstacle avoidance."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class PotentialFieldNavigation(NavigationSystem):\n",
    "    \"\"\"Navigation system using artificial potential fields\"\"\"\n",
    "    \n",
    "    def __init__(self, robot_radius=0.3, max_speed=1.0, max_angular_speed=1.0):\n",
    "        super().__init__(robot_radius, max_speed, max_angular_speed)\n",
    "        \n",
    "        # Potential field parameters\n",
    "        self.attractive_gain = 1.0\n",
    "        self.repulsive_gain = 2.0\n",
    "        self.obstacle_influence_dist = 2.0\n",
    "    \n",
    "    def compute_potential_field_control(self):\n",
    "        \"\"\"Compute control using artificial potential fields\"\"\"\n",
    "        # Calculate attractive force toward goal\n",
    "        to_goal = self.goal - self.position\n",
    "        distance_to_goal = np.linalg.norm(to_goal)\n",
    "        \n",
    "        if distance_to_goal < 0.1:\n",
    "            return np.array([0.0, 0.0, 0.0]), 0.0\n",
    "        \n",
    "        # Normalize and scale attractive force\n",
    "        attractive_force = self.attractive_gain * to_goal / distance_to_goal\n",
    "        \n",
    "        # Calculate repulsive forces from obstacles\n",
    "        repulsive_force = np.array([0.0, 0.0])\n",
    "        \n",
    "        for obs in self.detected_obstacles:\n",
    "            obs_pos = np.array([obs['x'], obs['y']])\n",
    "            to_obs = obs_pos - self.position\n",
    "            dist_to_obs = np.linalg.norm(to_obs)\n",
    "            \n",
    "            if dist_to_obs < self.obstacle_influence_dist:\n",
    "                # Repulsive force magnitude decreases with distance\n",
    "                if dist_to_obs > 0.1:  # Avoid division by zero\n",
    "                    repulsion_strength = self.repulsive_gain * \\\n",
    "                        (1/dist_to_obs - 1/self.obstacle_influence_dist) / (dist_to_obs**2)\n",
    "                    repulsive_force += repulsion_strength * (to_obs / dist_to_obs)\n",
    "                else:\n",
    "                    # Very close to obstacle, maximum repulsion\n",
    "                    repulsive_force += 100 * (to_obs / np.linalg.norm(to_obs))\n",
    "        \n",
    "        # Combine forces\n",
    "        total_force = attractive_force + repulsive_force\n",
    "        \n",
    "        # Calculate desired orientation\n",
    "        if np.linalg.norm(total_force) > 0.01:\n",
    "            desired_orientation = math.atan2(total_force[1], total_force[0])\n",
    "        else:\n",
    "            desired_orientation = self.orientation\n",
    "        \n",
    "        # Calculate orientation error\n",
    "        orientation_error = desired_orientation - self.orientation\n",
    "        \n",
    "        # Normalize orientation error\n",
    "        while orientation_error > math.pi:\n",
    "            orientation_error -= 2 * math.pi\n",
    "        while orientation_error < -math.pi:\n",
    "            orientation_error += 2 * math.pi\n",
    "        \n",
    "        # Calculate control commands\n",
    "        angular_vel = 2.0 * orientation_error\n",
    "        angular_vel = max(-self.max_angular_speed, min(self.max_angular_speed, angular_vel))\n",
    "        \n",
    "        # Linear velocity based on distance to goal and obstacle proximity\n",
    "        linear_vel = self.max_speed\n",
    "        \n",
    "        # Slow down when close to obstacles\n",
    "        min_obs_dist = float('inf')\n",
    "        for obs in self.detected_obstacles:\n",
    "            obs_pos = np.array([obs['x'], obs['y']])\n",
    "            dist = np.linalg.norm(self.position - obs_pos)\n",
    "            min_obs_dist = min(min_obs_dist, dist)\n",
    "        \n",
    "        if min_obs_dist < 0.5:\n",
    "            linear_vel *= min_obs_dist / 0.5\n",
    "        \n",
    "        # Slow down when close to goal\n",
    "        if distance_to_goal < 1.0:\n",
    "            linear_vel *= distance_to_goal\n",
    "        \n",
    "        linear_vel = max(0.05, linear_vel)  # Minimum speed\n",
    "        \n",
    "        return np.array([linear_vel, 0.0, 0.0]), angular_vel\n",
    "\n",
    "# Test the potential field navigation\n",
    "pf_nav = PotentialFieldNavigation()\n",
    "pf_nav.position = np.array([1.0, 1.0])\n",
    "pf_nav.goal = np.array([8.0, 8.0])\n",
    "\n",
    "# Add some obstacles\n",
    "pf_nav.detected_obstacles = [\n",
    "    {'x': 4.0, 'y': 3.0, 'radius': 0.5},\n",
    "    {'x': 6.0, 'y': 5.0, 'radius': 0.7},\n",
    "    {'x': 3.0, 'y': 7.0, 'radius': 0.4}\n",
    "]\n",
    "\n",
    "print(\"Potential field navigation system initialized\")\n",
    "print(f\"Robot position: {pf_nav.position}\")\n",
    "print(f\"Goal position: {pf_nav.goal}\")\n",
    "print(f\"Detected obstacles: {len(pf_nav.detected_obstacles)}\")"
   ]
  },
