   "source": [
    "## Exercise 1: Understanding Integrated Navigation Systems\n",
    "\n",
    "Navigation in Physical AI requires tight integration between perception and control. Let's start by understanding the components involved."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Import necessary libraries\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import cv2\n",
    "from typing import List, Tuple, Optional\n",
    "import time\n",
    "import math\n",
    "\n",
    "print(\"Libraries imported successfully\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Exercise 2: Creating a Navigation System Class\n",
    "\n",
    "Let's implement a complete navigation system that integrates perception and control."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class NavigationSystem:\n",
    "    \"\"\"Integrated navigation system combining perception and control\"\"\"\n",
    "    \n",
    "    def __init__(self, robot_radius=0.3, max_speed=1.0, max_angular_speed=1.0):\n",
    "        self.robot_radius = robot_radius\n",
    "        self.max_speed = max_speed\n",
    "        self.max_angular_speed = max_angular_speed\n",
    "        \n",
    "        # Robot state\n",
    "        self.position = np.array([0.0, 0.0])\n",
    "        self.orientation = 0.0  # in radians\n",
    "        self.velocity = np.array([0.0, 0.0])\n",
    "        \n",
    "        # Navigation state\n",
    "        self.goal = np.array([5.0, 5.0])\n",
    "        self.path = []\n",
    "        self.current_path_index = 0\n",
    "        \n",
    "        # Obstacle detection\n",
    "        self.detected_obstacles = []\n",
    "        \n",
    "    def update_robot_state(self, pos: np.ndarray, orient: float, vel: np.ndarray):\n",
    "        \"\"\"Update robot state from simulation or sensors\"\"\"\n",
    "        self.position = pos\n",
    "        self.orientation = orient\n",
    "        self.velocity = vel\n",
    "    \n",
    "    def detect_obstacles(self, sensor_data: dict):\n",
    "        \"\"\"Detect obstacles from sensor data (simulated LIDAR or camera data)\"\"\"\n",
    "        # In a real system, this would process actual sensor data\n",
    "        # For simulation, we'll generate obstacles based on environment\n",
    "        \n",
    "        # Simulate detection of obstacles in front of robot\n",
    "        detection_range = 3.0  # meters\n",
    "        detection_angle = math.pi / 3  # 60 degree field of view\n",
    "        \n",
    "        simulated_obstacles = []\n",
    "        \n",
    "        # Generate some obstacles in front of the robot\n",
    "        for i in range(3):\n",
    "            angle = self.orientation + (i - 1) * detection_angle / 2\n",
    "            distance = np.random.uniform(0.5, detection_range)\n",
    "            x = self.position[0] + distance * math.cos(angle)\n",
    "            y = self.position[1] + distance * math.sin(angle)\n",
    "            \n",
    "            # Only add if it's a valid obstacle (not too close to robot path)\n",
    "            if distance < detection_range:\n",
    "                simulated_obstacles.append({'x': x, 'y': y, 'radius': 0.2})\n",
    "        \n",
    "        self.detected_obstacles = simulated_obstacles\n",
    "        return self.detected_obstacles\n",
    "    \n",
    "    def plan_local_path(self):\n",
    "        \"\"\"Plan a local path around detected obstacles\"\"\"\n",
    "        if not self.detected_obstacles:\n",
    "            # No obstacles, continue with global path\n",
    "            return self.follow_global_path()\n",
    "        \n",
    "        # Simple obstacle avoidance: go around the closest obstacle\n",
    "        closest_obstacle = min(self.detected_obstacles, \n",
    "                              key=lambda obs: np.linalg.norm(self.position - np.array([obs['x'], obs['y']])))\n",
    "        \n",
    "        # Calculate avoidance direction\n",
    "        obs_pos = np.array([closest_obstacle['x'], closest_obstacle['y']])\n",
    "        to_robot = self.position - obs_pos\n",
    "        distance = np.linalg.norm(to_robot)\n",
    "        \n",
    "        if distance < closest_obstacle['radius'] + self.robot_radius:\n",
    "            # We're too close, need to avoid\n",
    "            avoidance_dir = to_robot / distance\n",
    "            # Rotate 90 degrees to go around\n",
    "            avoidance_dir = np.array([-avoidance_dir[1], avoidance_dir[0]])\n",
    "            \n",
    "            # Calculate avoidance point\n",
    "            avoidance_point = obs_pos + avoidance_dir * (closest_obstacle['radius'] + self.robot_radius + 0.1)\n",
    "            return avoidance_point\n",
    "        \n",
    "        # Otherwise, continue with global path\n",
    "        return self.follow_global_path()\n",
    "    \n",
    "    def follow_global_path(self):\n",
    "        \"\"\"Follow the global path if available, otherwise head toward goal\"\"\"\n",
    "        if self.path and self.current_path_index < len(self.path):\n",
    "            # Follow the next waypoint in the path\n",
    "            target = np.array(self.path[self.current_path_index])\n",
    "            \n",
    "            # Check if we've reached the current waypoint\n",
    "            if np.linalg.norm(self.position - target) < 0.3:\n",
    "                self.current_path_index += 1\n",
    "                if self.current_path_index < len(self.path):\n",
    "                    target = np.array(self.path[self.current_path_index])\n",
    "                else:\n",
    "                    # Path completed, head to goal\n",
    "                    target = self.goal\n",
    "        else:\n",
    "            # No path available, go directly to goal\n",
    "            target = self.goal\n",
    "        \n",
    "        return target\n",
    "    \n",
    "    def compute_control_commands(self):\n",
    "        \"\"\"Compute velocity commands based on target\"\"\"\n",
    "        target = self.plan_local_path()\n",
    "        \n",
    "        # Calculate direction to target\n",
    "        to_target = target - self.position\n",
    "        distance = np.linalg.norm(to_target)\n",
    "        \n",
    "        if distance < 0.1:  # Close enough to target\n",
    "            return np.array([0.0, 0.0]), 0.0  # Stop\n",
    "        \n",
    "        # Normalize direction\n",
    "        direction = to_target / distance\n",
    "        \n",
    "        # Calculate desired heading\n",
    "        desired_heading = math.atan2(direction[1], direction[0])\n",
    "        \n",
    "        # Calculate heading error\n",
    "        heading_error = desired_heading - self.orientation\n",
    "        \n",
    "        # Normalize heading error to [-π, π]\n",
    "        while heading_error > math.pi:\n",
    "            heading_error -= 2 * math.pi\n",
    "        while heading_error < -math.pi:\n",
    "            heading_error += 2 * math.pi\n",
    "        \n",
    "        # Calculate angular velocity proportional to heading error\n",
    "        angular_vel = 2.0 * heading_error\n",
    "        angular_vel = max(-self.max_angular_speed, min(self.max_angular_speed, angular_vel))\n",
    "        \n",
    "        # Calculate linear velocity based on heading error\n",
    "        # Reduce speed when turning sharply\n",
    "        linear_vel = self.max_speed * math.cos(heading_error)\n",
    "        linear_vel = max(0.1, linear_vel)  # Minimum speed\n",
    "        \n",
    "        # If we're very close to target, slow down\n",
    "        if distance < 1.0:\n",
    "            linear_vel *= distance  # Linearly decrease speed as we approach\n",
    "        \n",
    "        return np.array([linear_vel, 0.0, 0.0]), angular_vel\n",
    "    \n",
    "    def update_global_path(self, new_path: List[Tuple[float, float]]):\n",
    "        \"\"\"Update the global path\"\"\"\n",
    "        self.path = new_path\n",
    "        self.current_path_index = 0\n",
    "\n",
    "# Create a navigation system instance\n",
    "nav_system = NavigationSystem()\n",
    "print(\"Navigation system initialized\")"
   ]
  },
  {
