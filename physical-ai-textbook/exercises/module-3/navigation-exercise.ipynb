    "# TODO: Implement a hybrid navigation strategy that combines:\n",
    "# 1. Global path planning (A* or Dijkstra)\n",
    "# 2. Local obstacle avoidance (potential fields or other method)\n",
    "# 3. Dynamic obstacle handling\n",
    "\n",
    "class HybridNavigation(NavigationSystem):\n",
    "    def __init__(self, robot_radius=0.3, max_speed=1.0, max_angular_speed=1.0):\n",
    "        super().__init__(robot_radius, max_speed, max_angular_speed)\n",
    "        \n",
    "        # Add parameters for your hybrid approach\n",
    "        self.local_goal_distance = 1.0  # Distance to local goal\n",
    "        self.replan_threshold = 0.5     # Distance threshold to replan\n",
    "        \n",
    "    def compute_hybrid_control(self):\n",
    "        \"\"\"Implement your hybrid navigation approach here\"\"\"\n",
    "        # This is a basic implementation - you should enhance it\n",
    "        \n",
    "        # If we have detected obstacles very close, use reactive avoidance\n",
    "        closest_obstacle_dist = float('inf')\n",
    "        for obs in self.detected_obstacles:\n",
    "            obs_pos = np.array([obs['x'], obs['y']])\n",
    "            dist = np.linalg.norm(self.position - obs_pos)\n",
    "            closest_obstacle_dist = min(closest_obstacle_dist, dist)\n",
    "        \n",
    "        if closest_obstacle_dist < 0.5:  # Very close obstacle\n",
    "            # Reactive obstacle avoidance\n",
    "            avoidance_vector = np.array([0.0, 0.0])\n",
    "            \n",
    "            for obs in self.detected_obstacles:\n",
    "                if closest_obstacle_dist < 0.5:\n",
    "                    obs_pos = np.array([obs['x'], obs['y']])\n",
    "                    to_robot = self.position - obs_pos\n",
    "                    dist = np.linalg.norm(to_robot)\n",
    "                    if dist > 0:\n",
    "                        # Repulsive vector\n",
    "                        repulse = (to_robot / dist) * (1.0 / (dist**2))\n",
    "                        avoidance_vector += repulse\n",
    "            \n",
    "            if np.linalg.norm(avoidance_vector) > 0.01:\n",
    "                desired_orientation = math.atan2(avoidance_vector[1], avoidance_vector[0])\n",
    "            else:\n",
    "                desired_orientation = self.orientation\n",
    "            \n",
    "            orientation_error = desired_orientation - self.orientation\n",
    "            while orientation_error > math.pi:\n",
    "                orientation_error -= 2 * math.pi\n",
    "            while orientation_error < -math.pi:\n",
    "                orientation_error += 2 * math.pi\n",
    "            \n",
    "            angular_vel = 3.0 * orientation_error\n",
    "            angular_vel = max(-self.max_angular_speed, min(self.max_angular_speed, angular_vel))\n",
    "            \n",
    "            linear_vel = 0.3  # Slow down when avoiding\n",
    "            \n",
    "            return np.array([linear_vel, 0.0, 0.0]), angular_vel\n",
    "        \n",
    "        # Otherwise, use normal path following\n",
    "        return self.compute_control_commands()\n",
